# FeedShield Environment Configuration Example

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
ENVIRONMENT=development
SECRET_KEY=feedshield_development_secret_key_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Defaults to SQLite for instant local dev & demo)
DATABASE_URL=sqlite:///./feedshield.db
# For PostgreSQL via docker-compose:
# DATABASE_URL=postgresql://feedshield:feedshield_pass@localhost:5432/feedshield_db

# Storage Directories
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_AUDIO=true
